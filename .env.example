# Copie para .env antes de subir o ambiente. O arquivo .env não é versionado.
POSTGRES_USER=eduinfra
POSTGRES_PASSWORD=defina_uma_senha_local
POSTGRES_DB=eduinfra
PORTA_POSTGRES=5432

# Credenciais independentes dos papéis criados pela migração 0010.
# Em produção, defina segredos distintos e fortes por papel.
EDUINFRA_SENHA_CARGA=senha_local_carga
EDUINFRA_SENHA_DBT=senha_local_dbt
EDUINFRA_SENHA_CDC=senha_local_cdc
EDUINFRA_SENHA_CDC_BANCADA=senha_local_cdc_bancada
EDUINFRA_SENHA_PAINEL=senha_local_painel
EDUINFRA_SENHA_ANALISE=senha_local_analise
EDUINFRA_SENHA_TECNICO_DF=senha_local_tecnico_df
EDUINFRA_SENHA_TECNICO_SP=senha_local_tecnico_sp
EDUINFRA_SENHA_ORQUESTRADOR=senha_local_orquestrador

# Fora do Docker: rotina usa o papel de carga, como no Compose.
DATABASE_URL=postgresql://eduinfra_carga:senha_local_carga@localhost:5432/eduinfra
# Só migrações (migrar/reverter) usam o superusuário; obrigatório fora do Docker.
DATABASE_URL_ADMIN=postgresql://eduinfra:defina_uma_senha_local@localhost:5432/eduinfra
# construir-gold (opção nula) e o passo dbt usam o papel de transformação.
DATABASE_URL_TRANSFORMACAO=postgresql://eduinfra_dbt:senha_local_dbt@localhost:5432/eduinfra
# Orquestrador, consumidor CDC contínuo e ferramentas de bancada do CDC:
DATABASE_URL_ORQUESTRADOR=postgresql://eduinfra_orquestrador:senha_local_orquestrador@localhost:5432/eduinfra
DATABASE_URL_CDC=postgresql://eduinfra_cdc:senha_local_cdc@localhost:5432/eduinfra
DATABASE_URL_CDC_BANCADA=postgresql://eduinfra_cdc_bancada:senha_local_cdc_bancada@localhost:5432/eduinfra

ANO_CENSO=2024
URL_CENSO=https://download.inep.gov.br/dados_abertos/microdados_censo_escolar_2024.zip
ANO_ENEM=2024
URL_ENEM=https://download.inep.gov.br/microdados/microdados_enem_2024.zip

# Referência analítica da infraestrutura para o ENEM; não é campo do microdado.
DATA_REFERENCIA_ENEM=2024-11-03

# Horário do pipeline do orquestrador (cron). Cada execução reconstrói a Gold.
AGENDA_ORQUESTRADOR="0 3 * * *"
PORTA_DAGSTER=3000
