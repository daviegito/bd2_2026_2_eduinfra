# Copie para .env antes de subir o ambiente. O arquivo .env não é versionado.
POSTGRES_USER=eduinfra
POSTGRES_PASSWORD=defina_uma_senha_local
POSTGRES_DB=eduinfra
PORTA_POSTGRES=5432

# Senha única dos papéis de privilégio mínimo criados pela migração 0010.
# Em produção, defina uma senha forte por ambiente.
EDUINFRA_SENHA_PAPEIS=senha_local_dos_papeis

# Fora do Docker: rotina usa o papel de carga, como no Compose. Se mudar as
# senhas acima, atualize também as três DSNs abaixo.
DATABASE_URL=postgresql://eduinfra_carga:senha_local_dos_papeis@localhost:5432/eduinfra
# Só migrações (migrar/reverter) usam o superusuário; obrigatório fora do Docker.
DATABASE_URL_ADMIN=postgresql://eduinfra:defina_uma_senha_local@localhost:5432/eduinfra
# construir-gold (opção nula) e o passo dbt usam o papel de transformação.
DATABASE_URL_TRANSFORMACAO=postgresql://eduinfra_dbt:senha_local_dos_papeis@localhost:5432/eduinfra

ANO_CENSO=2024
URL_CENSO=https://download.inep.gov.br/dados_abertos/microdados_censo_escolar_2024.zip
ANO_ENEM=2024
URL_ENEM=https://download.inep.gov.br/microdados/microdados_enem_2024.zip

# Referência analítica da infraestrutura para o ENEM; não é campo do microdado.
DATA_REFERENCIA_ENEM=2024-11-03

# Horário do pipeline do orquestrador (cron). Cada execução reconstrói a Gold.
AGENDA_ORQUESTRADOR="0 3 * * *"
PORTA_DAGSTER=3000

# DSNs dos papéis (issue #86). O ADMIN fica só na migração; o orquestrador
# executa a transformação sem ser superusuário.
# DATABASE_URL_ADMIN=postgresql://eduinfra:senha_local_do_banco@localhost:5433/eduinfra
# DATABASE_URL_ORQUESTRADOR=postgresql://eduinfra_orquestrador:senha_local_dos_papeis@localhost:5433/eduinfra
# DATABASE_URL_TRANSFORMACAO=postgresql://eduinfra_dbt:senha_local_dos_papeis@localhost:5433/eduinfra
# DATABASE_URL_CDC_BANCADA=postgresql://eduinfra_cdc_bancada:senha_local_dos_papeis@localhost:5433/eduinfra
# EDUINFRA_SENHA_PAPEIS=senha_local_dos_papeis
