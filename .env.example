# Copie para .env antes de subir o ambiente. O arquivo .env não é versionado.
POSTGRES_USER=eduinfra
POSTGRES_PASSWORD=defina_uma_senha_local
POSTGRES_DB=eduinfra
PORTA_POSTGRES=5432

# Usada pelos comandos rodados fora do Docker, contra o banco publicado na porta acima.
DATABASE_URL=postgresql://eduinfra:defina_uma_senha_local@localhost:5432/eduinfra

ANO_CENSO=2024
URL_CENSO=https://download.inep.gov.br/dados_abertos/microdados_censo_escolar_2024.zip
