+
+    linhas = consultar(
+        dsn,
+        """
+        select f.ano, f.n_existentes, f.lab_ciencias, f.internet, d.valid_from::date, f.pct_existentes
+        from gold.fato_infra_escola_ano f
+        join gold.dim_escola_infraestrutura d using (escola_infra_sk)
